# JWT
# docker-compose.yml підставляє ці значення в сервіс backend через ${...}
# (секція environment має пріоритет над env_file: ./backend/.env).
# Якщо змінних тут немає — Compose підставляє порожній рядок і backend
# падає на старті з "JWT_SECRET is not set in .env".
# Значення мають збігатися з JWT_SECRET / JWT_REFRESH_SECRET у backend/.env.
JWT_SECRET=
JWT_REFRESH_SECRET=

{
  "name": "capstone-project-root",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev": "pnpm --parallel --filter \"./*\" dev",
    "build": "pnpm --recursive build",
    "test:load": "k6 run infra/test/load_test.js",
    "test:load:vps": "k6 run --env TARGET_HOST=https://zmina.pp.ua:5000/api infra/test/load_test.js",
    "test:load:aws": "k6 run --env TARGET_HOST=https://api.yourdomain-aws.com infra/test/load_test.js"
  },
  "pnpm": {
    "overrides": {
      "immer": "11.1.15"
    },
    "onlyBuiltDependencies": [
      "bcrypt",
      "@scarf/scarf",
      "unrs-resolver"
    ]
  }
}
